# Kopieer dit bestand naar .env en vul aan waar nodig.
# Alles hieronder is optioneel om te starten — USGS en de maanstand werken zonder sleutel.

PORT=4780

# Locatie waarvoor "afstand tot jou" berekend wordt (standaard: Utrecht)
HOME_LAT=52.0907
HOME_LON=5.1214

# KNMI EDR API (NIET de "Open Data API" — aparte, eigen sleutel nodig),
# geregistreerde sleutel aanvragen via https://developer.dataplatform.knmi.nl/
# (API Catalog > EDR API > "Request an API key"). Zie sources/knmi.js.
KNMI_API_KEY=

# NASA APIs (DONKI/NeoWs) — gratis sleutel via https://api.nasa.gov/, DEMO_KEY werkt ook (lage rate limit)
NASA_API_KEY=DEMO_KEY

# Testfixture: op 1 zetten om één keer een gesimuleerde tornado-watch te zien
# (duidelijk als TEST gemarkeerd) zonder te wachten op een echte actieve VS-
# watch. Na het testen weer terug naar 0/verwijderen en herstarten.
WEER_TEST_TORNADO_WATCH=0

# Testfixture: net als hierboven, maar dan een gesimuleerde tornado-melding
# op de ECHTE locatie/zoekterm van de tornado in Putnam County, IL
# (2026-08-22) — om de media-historie-laag (mediaHistorie.js, zie
# sources/nws.js) te controleren: dit doet een ECHTE SearXNG-zoekopdracht
# ("Putnam County Illinois tornado"), geen nepdata zoals bij
# WEER_TEST_TORNADO_WATCH. Vereist dus wel COMMUNITY_MEDIA_INGESCHAKELD=1 en
# een bereikbare SearXNG-instance (zie hieronder) om ook echt iets te tonen.
# Na het testen weer terug naar 0/verwijderen en herstarten.
WEER_TEST_PUTNAM_TORNADO=0

# Pushover — stuurt een telefoonalarm (ook als de app niet openstaat, ook
# door stil/niet-storen heen) bij een tornado warning/watch (VS) of code
# oranje/rood-weeralarm (NL). Optioneel: zonder deze twee blijft de rest van
# de app gewoon werken, er gaan dan alleen geen Pushover-alarmen uit.
# PUSHOVER_APP_TOKEN: maak een "applicatie" aan via https://pushover.net/apps/build
# PUSHOVER_USER_KEY: staat in de Pushover-app op je telefoon zelf
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Tijdelijk uitzetten zonder de sleutels hierboven kwijt te raken: op 0 zetten.
# Weer aan: gewoon terug naar 1 (of de regel weghalen), geen sleutels opnieuw nodig.
PUSHOVER_INGESCHAKELD=1

# E-mailalarm (zie backend/src/sources/email.js) — alternatief/aanvulling op
# Pushover hierboven, verstuurt een gewone e-mail bij dezelfde signalen
# (tornado warning/watch VS, code oranje/rood NL). Gebruikt Gmail SMTP met
# een app-wachtwoord (hoeft niet per se een nieuw account: Lex hergebruikt
# hier het app-wachtwoord van zijn vogel-app, zelfde Gmail-account).
# EMAIL_GEBRUIKER: het Gmail-adres.
# EMAIL_APP_WACHTWOORD: het 16-tekens app-wachtwoord (Google-account ->
# Beveiliging -> App-wachtwoorden — vereist 2-staps-verificatie aan).
# EMAIL_ONTVANGER: optioneel, standaard hetzelfde adres als EMAIL_GEBRUIKER.
EMAIL_GEBRUIKER=
EMAIL_APP_WACHTWOORD=
EMAIL_ONTVANGER=
# Zelfde aan/uit-patroon als PUSHOVER_INGESCHAKELD hierboven.
EMAIL_INGESCHAKELD=1

# Community-foto's/video's (SearXNG, Wikimedia Commons, Reddit, Bluesky —
# zie backend/src/sources/media.js) bij signalen zoals tornado/orkaan/onweer.
# 2026-08-20 op verzoek van Lex UIT gezet ("te veel misses") — anders dan
# PUSHOVER_INGESCHAKELD/EMAIL_INGESCHAKELD hierboven is deze standaard UIT,
# dus weglaten/leeg laten = uit. Op 1 zetten om weer aan te zetten (met
# SearXNG erbij, zie hieronder, is de trefkans een stuk hoger dan op
# 2026-08-20 — dat was vóór SearXNG alleen Wikimedia/Reddit/Bluesky).
# 2026-08-22: nws.js zoekt niet meer maar één keer per melding — zie
# backend/src/mediaHistorie.js: elke melding wordt tot 48 uur na ontstaan elke
# 3 uur opnieuw doorzocht (ook nadat de melding zelf al "verlopen" is), zodat
# later verschenen nieuws/video alsnog wordt opgepikt.
COMMUNITY_MEDIA_INGESCHAKELD=0

# SearXNG — zelfgehoste metazoekmachine, gebruikt door
# backend/src/sources/searxng.js als vierde community-media-bron, op verzoek
# van Lex 2026-08-22 (de smallere Reddit/Wikimedia/Bluesky-bronnen misten
# lokaal nieuws/storm-chaser-video's die een gewone brede zoekopdracht wél
# meteen vond — Tavily eerst geprobeerd, bleek toch een creditcard te
# vragen, teruggedraaid). Draait als eigen Docker-container op de
# Minisforum zelf (zie ~/searxng daar) — geen account, geen sleutel, geen
# kosten. Optioneel: zonder een bereikbare instance blijft deze ene bron
# leeg, de rest (incl. de andere drie media-bronnen) werkt door.
# Standaard http://localhost:8090 (poort 8090 gekozen om niet te botsen met
# bestaande Tailscale-serve-mappingen op 8080, zie architectuurdocument).
SEARXNG_URL=http://localhost:8090

# Getij (hoog-/laagwater, zie backend/src/sources/getij.js) — toont elk
# RWS-getijstation binnen deze straal van HOME_LAT/HOME_LON hierboven.
# Standaard 60km. Optioneel aanpasbaar, bv. ruimer zetten als er nog geen
# station binnen bereik valt (zie de "[weer] getij:"-logregel bij opstarten,
# die vermeldt altijd het dichtstbijzijnde kandidaat-station + afstand).
GETIJ_STRAAL_KM=60

# Kaartje bij het e-mailalarm (zie backend/src/sources/email.js,
# kaartUrlVoor()) — tekent de gebied-omtrek (of anders een pin) van het
# signaal op een kleine kaart en stuurt die als afbeelding mee in de mail.
# Optioneel: zonder sleutel werkt het e-mailalarm gewoon door, alleen zonder
# kaartje. Gratis sleutel, geen creditcard nodig: maak een account op
# https://www.geoapify.com/ -> Projects -> API key.
GEOAPIFY_API_KEY=

# AISstream.io — voor de "vaarradar"-kaartlaag (live scheepsposities via AIS,
# zie backend/src/sources/vaarradar.js), op verzoek van Lex 2026-08-21.
# Gratis (beta) account nodig: log in op https://aisstream.io/ (kan met
# GitHub, alleen "public data"-toegang wordt gevraagd) en kopieer de API key
# van je dashboard. Optioneel: zonder sleutel blijft de vaarradar-laag
# gewoon leeg, de rest van de app werkt door.
AISSTREAM_API_KEY=

# Lokale AIS-ontvangst (RTL-SDR Blog V4 + AIS-catcher op lexdev-nw zelf,
# zie sources/vaarradarLokaal.js) — AIS-catcher draait daar al als service en
# serveert een GeoJSON-lijst met scheepsposities op deze URL (live bevestigd
# door Lex, 2026-08-31: "-N 8100" -> http://127.0.0.1:8100/geojson). Krijgt
# voorrang boven aisstream.io hierboven in server.js zodra deze bron
# posities heeft; aisstream.io blijft als terugval draaien. Leeg laten
# (VAARRADAR_LOKAAL_URL=) zet deze bron uit.
VAARRADAR_LOKAAL_URL=http://127.0.0.1:8100/geojson

# AISHub — aanvullende scheepsposities via hun aggregatienetwerk (zie
# sources/vaarradarAishub.js), op verzoek van Lex 2026-09-01: onze eigen
# ontvangst (VAARRADAR_LOKAAL_URL hierboven) blijft leidend en heeft
# voorrang per schip, maar mist soms berichten van schepen aan de rand van
# het antennebereik (hard gemeten 2026-09-01). AISHub vult dat aan -- geen
# fallback zoals AISSTREAM_API_KEY, maar een MERGE (elk schip krijgt een
# eigen "bron"-veld: lokaal of aishub).
# Sleutel/username krijg je door lid te worden: meld je aan via
# https://www.aishub.net/join-us MET een al werkend AIS-station (Lex' eigen
# RTL-SDR + AIS-catcher, al operationeel) -- zonder werkende ontvangst wordt
# een aanvraag niet goedgekeurd. Je krijgt dan een eigen UDP-poort om je
# ruwe NMEA-data naartoe te sturen (zie de -u-vlag in AIS-catcher's
# ExecStart, /etc/systemd/system/ais-catcher.service op lexdev-nw) en, na
# bevestiging, een eigen API-key/username terug (vorm: AH_<poort>_<cijfers>)
# -- dat is deze waarde hieronder. Optioneel: leeg laten = AISHub-laag blijft
# leeg, de rest (incl. de eigen ontvangst) werkt gewoon door.
# BELANGRIJK: deze sleutel NOOIT committen -- alleen in het echte .env-
# bestand op lexdev-nw zelf, net als de andere sleutels in dit bestand.
AISHUB_USERNAME=
# Gap-filter: AISHub-schepen binnen dit aantal km rond HOME_LAT/HOME_LON weglaten,
# omdat de eigen antenne (vaarradarLokaal.js) die toch al ziet en AISHub's positie
# daar alleen ouder/ruis is. Standaard 0 = uit. Pas aanzetten als de VHF-antenne
# gemonteerd is en het werkelijke bereik opnieuw gemeten is (met de meegeleverde
# antenne was dat ~11km, sessie-notitie 2026-09-01). Zie vaarradarAishub.js.
AISHUB_LOKALE_DEKKING_KM=0

# Web Push (zie backend/src/sources/webpush.js) — derde, rustige (niet-
# herhalende) alarmkanaal naast Pushover/e-mail hierboven, op verzoek van Lex
# 2026-08-22: Pushover's prioriteit-2 ("emergency") meldingen blijven net zo
# lang herhalen tot ze bevestigd worden, en dat vindt hij storend — dit is
# een gewone stille PWA-melding als alternatief (Pushover blijft gewoon ook
# actief). Werkt via een eenmalig zelf te genereren VAPID-sleutelpaar — geen
# account, geen sleutel bij een externe partij nodig. Genereer met:
#   npx web-push generate-vapid-keys
# en plak de twee sleutels hieronder (op ZOWEL je Windows-pc als de
# Minisforum-server los, zie architectuurdocument voor waarom .env niet
# gesynchroniseerd wordt).
# VAPID_PUBLIC_KEY is niet geheim (gaat gewoon naar de browser via
# /api/config) — VAPID_PRIVATE_KEY wel, nooit delen/committen.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contactadres dat in het VAPID-token gaat (vereist door de spec, browsers
# gebruiken dit alleen om een pushdienst-beheerder in geval van misbruik te
# kunnen bereiken) — een gewoon e-mailadres van jou volstaat.
VAPID_CONTACT_EMAIL=
# Zelfde aan/uit-patroon als PUSHOVER_INGESCHAKELD hierboven. Werkt pas
# zodra de sleutels hierboven zijn ingevuld ÉN je in de app zelf bij
# Instellingen op "Meldingen aanzetten" hebt getikt (dat maakt het eerste
# abonnement aan) — zonder abonnement blijft dit kanaal stil, ongeacht deze
# instelling.
WEBPUSH_INGESCHAKELD=1

# NAVTEX (maritieme veiligheidswaarschuwingen, zie backend/src/sources/
# navtex.js) — straal rond HOME_LAT/HOME_LON waarbinnen een bericht meetelt,
# gemeten vanaf de coördinaat IN het bericht zelf (indien aanwezig) of anders
# vanaf het zendstation. Standaard 450km (dekt globaal de Noordzee/het
# Kanaal). Optioneel aanpasbaar, net als GETIJ_STRAAL_KM hierboven.
# 2026-08-20: wordt ook gebruikt door sources/ukho.js (UKHO/Admiralty MSI —
# NAVAREA I + UK Coastal Warnings, "hetzelfde soort maritiem bericht" als
# NAVTEX voor Lex) — bewust geen aparte UKHO_STRAAL_KM.
NAVTEX_STRAAL_KM=450

# 2026-08-28: OpenSky API-client (accountpagina opensky-network.org ->
# "Create & Download Credential" -> credentials.json). Met deze twee ingevuld
# pollt Lifeliner geauthenticeerd: 4.000 credits/dag i.p.v. ~400 anoniem
# (en 8.000 zodra je feedt — dat hoogt OpenSky server-side vanzelf op,
# zelfde credentials). Leeg laten = anoniem, alles blijft gewoon werken.
OPENSKY_CLIENT_ID=lexvis-api-client
OPENSKY_CLIENT_SECRET=

# Dagbudget-rem voor Lifeliner: standaard 3500 met credentials (marge onder
# de 4.000), 300 zonder. Alleen invullen om af te wijken.
# OPENSKY_DAG_BUDGET=3500

# Spaarstand-hartslag: hoe vaak Lifeliner pollt als er NIETS aan de hand is
# (geen toestel in de lucht, geen MMT-oproep) maar de app wel openstaat.
# Standaard 10 minuten (600000 ms).
# LIFELINER_HEARTBEAT_MS=600000
